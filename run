#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname "${BASH_SOURCE[0]}")"

setup-prek__() {
  local -r FORCE="${1-}"
  [[ -n $FORCE || ! -f ._done-setup-prek ]] || return 0
  if command -v prek >/dev/null; then
    uv tool upgrade prek
  else
    uv tool install prek
  fi
  if [ -f .git/hooks/pre-commit ]; then
    if grep -q ' pre-commit ' .git/hooks/pre-commit; then
      uv tool run prek install -f
    fi
  else
    uv tool run prek install
  fi
  touch ._done-setup-prek
}

setup__() {
  local -r FORCE="${1-}"
  local -r QUIET="${2-}"
  setup-prek__ "$FORCE"
  [[ -n $QUIET ]] || printf '\nAll done!\n'
}

prek__() {
  setup__ '' yes
  uv tool run prek run --all-files --hook-stage manual "$@"
}

mirror__() {
  setup__ '' yes
  ./scripts/mirror.bash "$@"
}

tests__() {
  setup__ '' yes
  ./tests/tests "$@"
}

main__() {
  local COMMANDS='mirror|prek|setup|tests'
  local CMD="${1:-}"
  if (($#)); then
    shift
  fi
  if [[ "|$COMMANDS|" == *"|$CMD|"* ]]; then
    "${CMD}__" "$@"
  else
    printf 'Usage: %s [%s] [arguments...]\n' "$0" "$COMMANDS">&2
    return 2
  fi
}

main__ "$@"
